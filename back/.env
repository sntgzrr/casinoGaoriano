# ============================================================================
# Django .env Example
# ============================================================================

# Debug mode (set to True in development, False in production)
DEBUG=False

# Secret key for Django (Generate a new one for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-this-in-production

# Allowed hosts (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ALLOWED_HOSTS=casino-gaoriano.up.railway.app

# Django log level
DJANGO_LOG_LEVEL=INFO


# ============================================================================
# CORS Settings (Frontend Configuration)
# ============================================================================

# Allowed origins for frontend requests (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=https://casino-gaoriano.up.railway.app

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=True


# ============================================================================
# Database Configuration
# ============================================================================

# Database URL (format: postgresql://user:password@host:port/database)
# SQLite (Development): sqlite:///db.sqlite3
# PostgreSQL (Production): postgresql://casino_user:casino_pass@db:5432/casino_db
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgresql://postgres:kPFihwutjnghDrsRGMueoyeyHdBswlYM@postgres.railway.internal:5432/railway

# PostgreSQL specific (used if not specified in DATABASE_URL)
# POSTGRES_DB=casino_db
# POSTGRES_USER=casino_user
# POSTGRES_PASSWORD=casino_pass


# ============================================================================
# Security Settings (Production Only)
# ============================================================================

# Enable SSL redirect in production
# SECURE_SSL_REDIRECT=False
SECURE_SSL_REDIRECT=True

# Secure session cookies in production
# SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True

# Secure CSRF cookies in production
# SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=True

# HSTS settings (in seconds, 1 year = 31536000)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Trusted proxies for SSL (comma-separated IPs)
TRUSTED_PROXIES=


# ============================================================================
# Internationalization
# ============================================================================

# Language code
LANGUAGE_CODE=en-us

# Timezone
TIME_ZONE=America/Bogota


# ============================================================================
# JWT (JSON Web Token) Configuration
# ============================================================================

# JWT token expiration time in minutes
JWT_EXPIRATION_MINUTES=60


# ============================================================================
# Database Connection Pool (Optional)
# ============================================================================

# Enable connection pooling for better database performance
USE_DB_CONNECTION_POOL=False

